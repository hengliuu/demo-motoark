{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motoark-demo-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-24",
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "motoark-demo-web" },
    { "binding": "API", "service": "motoark-demo-api" }
  ],
  "env": {
    "staging": {
      "name": "motoark-demo-web-staging",
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "motoark-demo-web-staging" },
        { "binding": "API", "service": "motoark-demo-api-staging" }
      ]
    },
    "production": {
      "name": "motoark-demo-web-production",
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "motoark-demo-web-production" },
        { "binding": "API", "service": "motoark-demo-api-production" }
      ]
    }
  }
}
