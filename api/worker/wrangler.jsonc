{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motoark-demo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
  "containers": [
    {
      "name": "motoark-demo-api",
      "class_name": "ApiContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],
  "env": {
    "staging": {
      "name": "motoark-demo-api-staging",
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
      "containers": [
        {
          "name": "motoark-demo-api-staging",
          "class_name": "ApiContainer",
          "image": "../Dockerfile",
          "image_build_context": "..",
          "max_instances": 2
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }]
    },
    "production": {
      "name": "motoark-demo-api-production",
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
      "containers": [
        {
          "name": "motoark-demo-api-production",
          "class_name": "ApiContainer",
          "image": "../Dockerfile",
          "image_build_context": "..",
          "max_instances": 5
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }]
    }
  }
}
